# ===== Root .gitignore: covers backend/ and frontend/ =====

# --- Secrets (commit only the .env.example files) ---
.env
.env.*
!.env.example

# --- Frontend (React / Vite) ---
node_modules/
dist/
*.local

# --- Backend (Laravel) ---
/backend/vendor/
/backend/storage/*.key
/backend/storage/logs/*
/backend/public/storage
/backend/public/hot
/backend/bootstrap/cache/*.php
/backend/.phpunit.cache
/backend/.phpunit.result.cache
/backend/database/*.sqlite
Homestead.json
Homestead.yaml
auth.json

# --- Editors / OS / logs ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
